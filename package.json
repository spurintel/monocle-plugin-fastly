{
	"name": "monocle-plugin-fastly",
	"version": "2.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"bundle": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=bin/index.js --external:fastly:*",
		"build": "npm run bundle && js-compute-runtime bin/index.js bin/main.wasm",
		"serve": "fastly compute serve",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@fastly/cli": "^15.3.1",
		"@fastly/js-compute": "^3.42.1",
		"esbuild": "^0.25.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"decompress": "npm:@xhmikosr/decompress@^11.1.3"
	},
	"dependencies": {
		"@spur.us/monocle-edge-core": "github:spurintel/monocle-edge-core#v0.7.5"
	},
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	}
}
